generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Address {
    id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    userId       Int      @map("user_id")
    fullName     String   @default("") @db.VarChar(255)
    phone        String   @default("") @db.VarChar(20)
    provinceCode Int      @map("province_code")
    provinceName String   @map("province_name") @db.VarChar(100)
    wardCode     Int      @map("ward_code")
    wardName     String   @map("ward_name") @db.VarChar(100)
    addressLine  String   @db.VarChar(500)
    addressExtra String?  @map("address_extra") @db.VarChar(50)
    isDefault    Boolean  @default(false) @map("is_default")
    createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)
    updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

    user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_addresses_user")

    @@index([provinceCode], map: "idx_addresses_province_code")
    @@index([userId], map: "idx_addresses_user_id")
    @@index([wardCode], map: "idx_addresses_ward_code")
    @@map("addresses")
}

model Brand {
    id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    name        String?   @db.VarChar(100)
    description String?
    createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
    updatedAt   DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

    products products[]

    @@index([id], map: "idx_brands_brand_id")
    @@map("brands")
}

model CartItem {
    id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    cartId    String    @map("cart_id") @db.Uuid
    variantId String    @map("variant_id") @db.Uuid
    quantity  Int       @default(1)
    createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

    cart             Cart             @relation(fields: [cartId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_cart_item_cart")
    product_variants product_variants @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_variant")

    @@unique([cartId, variantId])
    @@index([cartId], map: "idx_cart_items_cart_id")
    @@index([variantId], map: "idx_cart_items_variant_id")
    @@map("cart_items")
}

model Cart {
    id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    userId    Int       @unique @map("user_id")
    createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

    items CartItem[]
    user  User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user")

    @@index([userId], map: "idx_carts_user_id")
    @@map("carts")
}

model Category {
    id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    parent_id       String?         @db.Uuid
    gender          CategoryGender?
    categoryType    CategoryType?
    image_public_id String?         @db.VarChar(255)
    imageUrl        String?         @map("image_url") @db.VarChar(500)
    sort_order      Int             @default(0)
    is_active       Boolean         @default(true)
    created_at      DateTime        @default(now()) @db.Timestamptz(6)
    updated_at      DateTime        @updatedAt @db.Timestamptz(6)

    parent             Category?             @relation("CategoryHierarchy", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
    children           Category[]            @relation("CategoryHierarchy")
    translations       CategoryTranslation[]
    product_categories product_categories[]
    homepageCategory   HomepageCategory?

    @@index([parent_id], map: "idx_categories_parent_id")
    @@map("categories")
}

model Collection {
    id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    image        String
    publicId     String  @map("public_id") @db.VarChar(255)
    featured     Boolean @default(false)
    overlayClass String?

    createdAt              DateTime                @default(now())
    updatedAt              DateTime                @updatedAt
    collectionTranslations CollectionTranslation[]

    @@map("collections")
}

model CollectionTranslation {
    id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    collectionId String @db.Uuid
    languageCode String @map("language_code") @db.VarChar(5)

    // Các trường cần dịch
    name        String
    slug        String
    description String @db.Text

    collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
    languages  languages  @relation(fields: [languageCode], references: [code], onDelete: NoAction)

    @@unique([collectionId, languageCode])
    @@unique([languageCode, slug])
    @@map("collection_translations")
}

model HomepageCategory {
    id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    categoryId String   @unique @db.Uuid
    position   Int
    isActive   Boolean  @default(true)
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

    @@unique([position])
}

model CategoryTranslation {
    id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    categoryId   String  @map("category_id") @db.Uuid
    languageCode String  @map("language_code") @db.VarChar(5)
    name         String  @db.VarChar(255)
    slug         String  @db.VarChar(255)
    path         String? @db.VarChar(1000)
    description  String?

    category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: NoAction)
    languages languages @relation(fields: [languageCode], references: [code], onDelete: NoAction)

    @@unique([categoryId, languageCode], map: "unique_category_language")
    @@unique([path, languageCode], map: "unique_category_path_language")
    @@index([languageCode], map: "idx_category_trans_language")
    @@map("category_translations")
}

model CheckoutSession {
    id        Int      @id @default(autoincrement())
    sessionId String   @unique @map("session_id") @db.Uuid
    userId    Int      @map("user_id")
    cartId    Int      @map("cart_id")
    status    String   @default("pending") @db.VarChar(20)
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
    updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_checkout_user")

    @@index([cartId], map: "idx_checkout_cart_id")
    @@index([status], map: "idx_checkout_status")
    @@index([userId], map: "idx_checkout_user_id")
    @@map("checkout_sessions")
}

model MenuTranslation {
    id           String    @id @default(dbgenerated("gen_random_uuid()"))
    menuId       String    @map("menu_id") @db.Uuid
    languageCode String    @map("language_code") @db.VarChar(10)
    name         String    @db.VarChar(255)
    createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt    DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

    menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade, onUpdate: NoAction)

    @@unique([menuId, languageCode], map: "uk_menu_translations_menu_id_language_code")
    @@index([languageCode], map: "idx_menu_translations_locale")
    @@index([menuId], map: "idx_menu_translations_menu_id")
    @@map("menu_translations")
}

model Menu {
    id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    path      String    @db.VarChar(255)
    icon      String?   @db.VarChar(100)
    order     Int       @default(0)
    parentId  String?   @map("parent_id") @db.Uuid
    createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

    translations MenuTranslation[]
    parent       Menu?             @relation("MenuHierarchy", fields: [parentId], references: [id], onUpdate: NoAction, map: "fk_menus_parent_id")
    children     Menu[]            @relation("MenuHierarchy")

    @@index([parentId], map: "idx_menus_parent_id")
    @@map("menus")
}

model OrderItem {
    id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    orderId          String   @db.Uuid
    productId        String   @db.Uuid
    variantId        String   @db.Uuid
    productName      String
    variantName      String?
    imageUrl         String
    sku              String
    compare_at_price Int
    price            Int
    quantity         Int
    totalPrice       Int
    createdAt        DateTime @default(now())

    order   Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
    variant product_variants @relation(fields: [variantId], references: [id])

    @@index([orderId], map: "idx_order_items_order_id")
    @@index([productId], map: "idx_order_items_product_id")
    @@map("order_items")
}

model Order {
    id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    userId        Int           @map("user_id")
    orderNumber   String        @unique @map("order_number") @db.VarChar(30)
    email         String
    status        OrderStatus   @default(pending)
    note          String?
    paymentMethod PaymentMethod @map("payment_method")
    paymentStatus PaymentStatus @default(pending) @map("payment_status")
    subtotal      Int
    discount      Int           @default(0)
    shippingFee   Int           @default(0) @map("shipping_fee")
    totalAmount   Int           @map("total_amount")
    createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamp(6)
    updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
    checkout_id   String        @unique @db.Uuid

    items        OrderItem[]
    user         User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_orders_user")
    orderAddress OrderAddress?

    @@index([createdAt], map: "idx_orders_created_at")
    @@index([status], map: "idx_orders_status")
    @@index([userId], map: "idx_orders_user_id")
    @@map("orders")
}

model OrderAddress {
    id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    orderId      String   @unique @db.Uuid
    fullName     String   @default("") @map("receiver_name") @db.VarChar(255)
    phone        String   @default("") @db.VarChar(20)
    provinceCode Int      @map("province_code")
    provinceName String   @map("province_name") @db.VarChar(100)
    wardCode     Int      @map("ward_code")
    wardName     String   @map("ward_name") @db.VarChar(100)
    addressLine  String   @db.VarChar(500)
    addressExtra String?  @map("address_extra") @db.VarChar(50)
    createdAt    DateTime @default(now())
    updatedAt    DateTime @default(now()) @updatedAt

    order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

    @@map("order_addresses")
}

model QuoteTranslation {
    id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    quoteId      String    @map("quote_id") @db.Uuid
    languageCode String    @map("language_code") @db.VarChar(10)
    content      String
    createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt    DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

    quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade, onUpdate: NoAction)

    @@unique([quoteId, languageCode], map: "unique_quote_lang")
    @@map("quote_translations")
}

model Quote {
    id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    authorName    String    @map("author_name") @db.VarChar(100)
    source        String?   @db.VarChar(100)
    imageUrl      String?   @map("image_url") @db.VarChar(255)
    imagePublicId String?   @map("image_public_id") @db.VarChar(255)
    displayOrder  Int?      @default(0) @map("display_order")
    isActive      Boolean?  @default(true) @map("is_active")
    createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt     DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

    translations QuoteTranslation[]

    @@map("quotes")
}

model User {
    id                    Int       @id @default(autoincrement()) @map("user_id")
    fullName              String    @map("full_name") @db.VarChar(50)
    email                 String    @unique @db.VarChar(100)
    passwordHash          String    @map("password_hash") @db.VarChar(255)
    refreshTokenHash      String?   @map("refresh_token_hash") @db.VarChar(255)
    refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
    isVerified            Boolean?  @default(false) @map("is_verified")
    avatar_url            String?   @db.VarChar(255)
    role                  user_role @default(user)
    resend_count          Int       @default(0)
    last_resent_at        DateTime? @db.Timestamptz(6)
    createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

    addresses        Address[]
    cart             Cart?
    checkoutSessions CheckoutSession[]
    orders           Order[]
    refresh_tokens   refresh_tokens[]
    wishlists        wishlists[]
    otps             Otp[]

    @@map("users")
}

model ProductImage {
    id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    productId        String    @map("product_id") @db.Uuid
    attributeValueId String    @map("attribute_value_id") @db.Uuid
    publicId         String    @map("public_id") @db.VarChar(255)
    url              String
    width            Int?
    height           Int?
    format           String?   @db.VarChar(10)
    is_main          Boolean   @default(false)
    is_hover         Boolean   @default(false)
    displayOrder     Int       @default(0) @map("display_order")
    created_at       DateTime? @default(now()) @db.Timestamptz(6)

    product         products?         @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
    attribute_value attribute_values? @relation(fields: [attributeValueId], references: [id], onDelete: SetNull, onUpdate: NoAction)

    @@index([publicId], map: "idx_product_images_public_id")
    @@map("product_images")
}

// ==========================================
// 1. CHUYÊN MỤC BÀI VIẾT (Blog Category)
// ==========================================
model BlogCategory {
    id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    code      String   @unique // vd: "editorial", "styling-guide", "trends"
    sortOrder Int      @default(0) @map("sort_order")
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    posts        BlogPost[]
    translations BlogCategoryTranslation[]

    @@map("blog_categories")
}

model BlogCategoryTranslation {
    id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    categoryId   String @map("category_id") @db.Uuid
    languageCode String @map("language_code") @db.VarChar(5) // "en", "vi"
    name         String

    category BlogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

    @@unique([categoryId, languageCode])
    @@map("blog_category_translations")
}

// ==========================================
// 2. BÀI VIẾT (Blog Post)
// ==========================================
model BlogPost {
    id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    categoryId   String  @map("category_id") @db.Uuid
    authorId     String? @map("author_id") @db.Uuid // Liên kết bảng Users/Admin nếu có
    authorName   String  @map("author_name") // Tên hiển thị tác giả (vd: "KAIRA Atelier")
    authorAvatar String? @map("author_avatar") // URL Avatar tác giả

    coverImage String  @map("cover_image") // URL ảnh bìa
    coverAlt   String? @map("cover_alt") // SEO Alt text cho ảnh bìa
    readTime   String  @default("05 Min") @map("read_time") // "05 Min"

    isFeatured  Boolean  @default(false) @map("is_featured") // Bài viết nổi bật ở Hero Header
    status      String   @default("published") @db.VarChar(20) // "draft", "published"
    publishedAt DateTime @default(now()) @map("published_at")
    createdAt   DateTime @default(now()) @map("created_at")
    updatedAt   DateTime @updatedAt @map("updated_at")

    category        BlogCategory          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
    translations    BlogPostTranslation[]
    relatedProducts BlogPostProduct[]

    @@map("blog_posts")
}

// ==========================================
// 3. DỊCH THUẬT & SEO BÀI VIẾT (Translation)
// ==========================================
model BlogPostTranslation {
    id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    postId       String @map("post_id") @db.Uuid
    languageCode String @map("language_code") @db.VarChar(5) // "en", "vi"

    title       String
    slug        String // Chuẩn SEO URL (unique theo ngôn ngữ)
    description String @db.Text // Sapo / Mô tả ngắn bài viết
    contentHtml String @map("content_html") @db.Text // Nội dung Rich Text HTML

    post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

    @@unique([postId, languageCode])
    @@unique([slug, languageCode])
    @@map("blog_post_translations")
}

// ==========================================
// 4. BẢNG LIÊN KẾT: SHOP THE LOOK / FEATURED PRODUCTS
// ==========================================
model BlogPostProduct {
    id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    postId    String   @map("post_id") @db.Uuid
    productId String   @map("product_id") @db.Uuid
    sortOrder Int      @default(0) @map("sort_order")
    createdAt DateTime @default(now()) @map("created_at")

    post    BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
    product products @relation(fields: [productId], references: [id], onDelete: Cascade)

    @@unique([postId, productId])
    @@map("blog_post_products")
}

model attribute_translations {
    id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    attribute_id  String     @db.Uuid
    language_code String     @db.VarChar(5)
    name          String     @db.VarChar(100)
    attributes    attributes @relation(fields: [attribute_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
    languages     languages  @relation(fields: [language_code], references: [code], onDelete: NoAction)

    @@unique([attribute_id, language_code], map: "unique_attribute_language")
    @@index([language_code], map: "idx_attr_translations_lang")
}

model attribute_value_translations {
    id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    attribute_value_id String           @db.Uuid
    language_code      String           @db.VarChar(5)
    name               String           @db.VarChar(50)
    attribute_values   attribute_values @relation(fields: [attribute_value_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
    languages          languages        @relation(fields: [language_code], references: [code], onDelete: NoAction)

    @@unique([attribute_value_id, language_code], map: "unique_attr_value_language")
    @@index([language_code], map: "idx_attr_val_trans_lang")
}

model attribute_values {
    id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    attribute_id String   @db.Uuid
    value_code   String   @db.VarChar(100)
    sort_order   Int?     @default(0)
    created_at   DateTime @default(now()) @db.Timestamptz(6)

    attribute_value_translations attribute_value_translations[]
    attributes                   attributes                     @relation(fields: [attribute_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
    images                       ProductImage[]

    @@index([attribute_id], map: "idx_attr_values_attribute_id")
    @@index([sort_order], map: "idx_attr_values_sort")
}

model attributes {
    id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    slug                   String                   @unique @db.VarChar(50)
    display_type           attribute_display_type?  @default(text)
    created_at             DateTime?                @default(now()) @db.Timestamptz(6)
    attribute_translations attribute_translations[]
    attribute_values       attribute_values[]

    @@index([slug], map: "idx_attributes_slug")
}

model languages {
    code                         String                         @id @db.VarChar(5)
    name                         String                         @db.VarChar(50)
    is_default                   Boolean?                       @default(false)
    is_active                    Boolean?                       @default(true)
    created_at                   DateTime?                      @default(now()) @db.Timestamptz(6)
    attribute_translations       attribute_translations[]
    attribute_value_translations attribute_value_translations[]
    category_translations        CategoryTranslation[]
    product_translations         product_translations[]
    collectionTranslations       CollectionTranslation[]
}

model product_translations {
    id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    product_id    String  @db.Uuid
    language_code String  @db.VarChar(5)
    name          String  @db.VarChar(255)
    slug          String  @unique(map: "unique_product_slug") @db.VarChar(255)
    description   String?
    content       String?

    languages languages @relation(fields: [language_code], references: [code], onDelete: NoAction)
    products  products  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

    @@unique([product_id, language_code], map: "unique_product_language")
    @@index([name], map: "idx_product_translations_name")
    @@index([slug, language_code], map: "idx_product_translations_slug_lang")
}

model product_variants {
    id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    product_id       String          @db.Uuid
    option_value_ids String[]
    status           product_status? @default(active)
    sku              String          @unique @db.VarChar(100)
    compare_at_price Decimal?        @db.Decimal(12, 2)
    price            Decimal         @default(0) @db.Decimal(12, 2)
    discount_percent Int?
    stock            Int             @default(0)
    is_default       Boolean         @default(false)
    created_at       DateTime?       @default(now()) @db.Timestamptz(6)
    updated_at       DateTime?       @default(now()) @db.Timestamptz(6)

    cart_items CartItem[]
    products   products    @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
    wishlists  wishlists[]
    orderItems OrderItem[]

    @@index([option_value_ids], map: "idx_variants_options", type: Gin)
    @@index([product_id], map: "idx_variants_product_id")
    @@index([sku], map: "idx_variants_sku")
}

model products {
    id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    brand_id       String          @map("brand_id") @db.Uuid
    status         product_status? @default(active)
    is_best_seller Boolean         @default(false)
    created_at     DateTime?       @default(now()) @db.Timestamptz(6)
    updated_at     DateTime?       @default(now()) @db.Timestamptz(6)
    deleted_at     DateTime?       @db.Timestamptz(6)

    brand                 Brand?                 @relation(fields: [brand_id], references: [id], onDelete: SetNull)
    product_categories    product_categories[]
    product_translations  product_translations[]
    product_variants      product_variants[]
    variantImages         ProductImage[]
    productSpecifications ProductSpecification[]
    blogPost              BlogPostProduct[]

    @@index([created_at(sort: Desc)], map: "idx_products_created_at")
    @@index([status], map: "idx_products_status")
}

model product_categories {
    product_id  String @db.Uuid
    category_id String @db.Uuid

    categories Category @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
    products   products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

    @@id([product_id, category_id])
    @@index([category_id], map: "idx_product_categories_category_id")
}

model wishlists {
    id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    user_id          Int
    variant_id       String           @db.Uuid
    created_at       DateTime?        @default(now()) @db.Timestamptz(6)
    users            User             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_wishlist_user")
    product_variants product_variants @relation(fields: [variant_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_wishlist_variant")

    @@unique([user_id, variant_id], map: "unique_user_variant")
    @@index([user_id], map: "idx_wishlist_user_id")
}

model refresh_tokens {
    id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    user_id              Int
    token_hash           String
    expires_at           DateTime  @db.Timestamp(6)
    remember_me          Boolean?  @default(false)
    user_agent           String?
    ip_address           String?
    is_revoked           Boolean?  @default(false)
    replaced_by_token_id String?   @db.Uuid
    created_at           DateTime? @default(now()) @db.Timestamp(6)
    users                User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user")
}

model Otp {
    id        String   @id @default(uuid())
    userId    Int
    code      String // Mã OTP (Nên được HASH trước khi lưu để bảo mật)
    type      otp_type // Enum: VERIFY_EMAIL, RESET_PASSWORD, TWO_FACTOR
    expiresAt DateTime // Thời gian hết hạn (thường là 2-5 phút kể từ lúc tạo)
    isUsed    Boolean  @default(false) // Đánh dấu đã sử dụng chưa
    attempts  Int      @default(0) // Số lần user đã gõ sai mã này (max = 3 hoặc 5)
    createdAt DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId, code])
}

// 1. Từ điển Tên thông số (Master Data Key)
model SpecificationKey {
    id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    code      String   @unique
    sortOrder Int      @default(0)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    translations SpecificationKeyTranslation[]
    values       SpecificationValue[]
    productSpecs ProductSpecification[]

    @@map("specification_keys")
}

model SpecificationKeyTranslation {
    id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    keyId        String @db.Uuid
    languageCode String @map("language_code") @db.VarChar(5)
    title        String

    key SpecificationKey @relation(fields: [keyId], references: [id], onDelete: Cascade)

    @@unique([keyId, languageCode])
    @@map("specification_key_translations")
}

// 2. Từ điển Giá trị thông số (Master Data Value)
model SpecificationValue {
    id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    keyId     String   @db.Uuid
    sortOrder Int      @default(0)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    key          SpecificationKey                @relation(fields: [keyId], references: [id], onDelete: Cascade)
    translations SpecificationValueTranslation[]
    productSpecs ProductSpecification[]

    @@map("specification_values")
}

model SpecificationValueTranslation {
    id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    valueId      String @db.Uuid
    languageCode String @map("language_code") @db.VarChar(5)
    label        String

    value SpecificationValue @relation(fields: [valueId], references: [id], onDelete: Cascade)

    @@unique([valueId, languageCode])
    @@map("specification_value_translations")
}

// 3. Bảng gán Thông số cho Sản phẩm (Mới)
model ProductSpecification {
    id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    productId   String  @db.Uuid
    keyId       String  @db.Uuid
    valueId     String? @db.Uuid
    customValue Json?   @map("custom_value")

    product products            @relation(fields: [productId], references: [id], onDelete: Cascade)
    key     SpecificationKey    @relation(fields: [keyId], references: [id], onDelete: Cascade)
    value   SpecificationValue? @relation(fields: [valueId], references: [id], onDelete: SetNull)

    @@map("product_specifications")
}

model ShippingZone {
    id            String   @id @default(uuid())
    code          String   @unique // Ví dụ: "NOI_THANH", "MIEN_NAM", "MIEN_BAC"
    name          String
    baseFee       Int // Phí sàn (VND) cho 1kg đầu tiên
    stepFee       Int // Phí phụ trội (VND) cho mỗi 500g tiếp theo
    provinceCodes Int[] // Danh sách tên hoặc mã tỉnh thuộc zone này
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt
}

